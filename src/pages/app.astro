---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const appUrl = 'https://app.gunnerthelab.com';

const features = [
    {
        title: 'Install on any device',
        body: 'Phone, tablet, or computer — StoryReader installs straight from your browser like a real app. No app store, no sign-up hoops, no cost. Ever.'
    },
    {
        title: 'Read or listen',
        body: 'Every story comes with friendly audio narration, and the words light up as they’re read aloud — perfect for early readers following along, or for grown-ups who’d rather listen with their eyes closed.'
    },
    {
        title: 'Works offline',
        body: 'Download stories ahead of time and they’re yours anywhere — road trips, campsites, waiting rooms, or the far corner of the pasture where the signal never reaches.'
    },
    {
        title: 'Remembers your place',
        body: 'Start a story on the couch, finish it at bedtime on a different device. Your spot follows you, so nobody ever has to ask “wait, where were we?”'
    },
    {
        title: 'New-story alerts',
        body: 'Gunner isn’t done getting into trouble. Turn on notifications and you’ll know the moment a new adventure lands in the library.'
    },
    {
        title: 'The whole library',
        body: 'All 42 stories across all 8 eras — from the East Texas homestead to the Virginia mountains — in one tidy, kid-friendly reader.'
    }
];

const installGuides = [
    {
        device: 'iPhone & iPad',
        browser: 'Safari',
        steps: [
            'Open <strong>app.gunnerthelab.com</strong> in Safari.',
            'Tap the <strong>Share</strong> button — the square with the up arrow.',
            'Scroll down and tap <strong>Add to Home Screen</strong>.',
            'Tap <strong>Add</strong>.'
        ],
        note: 'On iPhone and iPad it has to be Safari — Chrome can’t install web apps.'
    },
    {
        device: 'Android',
        browser: 'Chrome',
        steps: [
            'Open <strong>app.gunnerthelab.com</strong> in Chrome.',
            'Tap the <strong>⋮</strong> menu in the top right.',
            'Tap <strong>Add to Home screen</strong> or <strong>Install app</strong>.',
            'Confirm.'
        ],
        note: ''
    },
    {
        device: 'Windows',
        browser: 'Chrome or Edge',
        steps: [
            'Open <strong>app.gunnerthelab.com</strong>.',
            'Click the <strong>install icon</strong> at the right end of the address bar.',
            'Or use <strong>⋮</strong> → <strong>Install this site as an app</strong> (Edge: <strong>⋯</strong> → <strong>Apps</strong>).',
            'Click <strong>Install</strong>.'
        ],
        note: ''
    },
    {
        device: 'Mac',
        browser: 'Chrome or Safari',
        steps: [
            'Open <strong>app.gunnerthelab.com</strong>.',
            '<strong>Chrome:</strong> click the install icon in the address bar, or <strong>⋮</strong> → <strong>Install…</strong>',
            '<strong>Safari</strong> (macOS Sonoma and later): <strong>File</strong> → <strong>Add to Dock</strong>.'
        ],
        note: ''
    }
];
---

<BaseLayout
    title="Get the App"
    description="StoryReader is the free app for The Adventures of Gunner the Lab — read or listen with word-by-word highlighting, download stories for offline, and pick up right where you left off on any device."
    showHeader={false}
>
    <!-- Hero -->
    <section class="mb-16 sm:mb-24">
        <header class="mb-8">
            <p class="mb-3 text-sm tracking-wide text-accent uppercase">Free App</p>
            <h1 class="font-serif text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">StoryReader</h1>
            <p class="mt-4 font-serif text-xl italic text-gray sm:text-2xl">Every Gunner adventure, in your pocket.</p>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <p>
                StoryReader is the free reading and listening app for <em>The Adventures of Gunner the Lab... Oh, and Tiger Too</em>.
                All 42 illustrated stories, read aloud with the words highlighted as you go, saved for offline, and synced across
                every device in the house. Built for bedtime, road trips, and everywhere in between.
            </p>
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-4">
            <Button href={appUrl}>Open StoryReader</Button>
            <span class="font-serif text-sm italic text-gray">Free. No app store required.</span>
        </div>
    </section>

    <!-- Features -->
    <section class="mb-16 sm:mb-24">
        <h2 class="mb-12 font-serif text-xl italic sm:mb-16 sm:text-2xl">What it does</h2>
        <div class="border-main divide-main divide-y divide-dashed border-t border-dashed">
            {
                features.map((feature) => (
                    <div class="py-6 sm:py-8">
                        <h3 class="font-serif text-xl leading-tight font-medium sm:text-2xl">{feature.title}</h3>
                        <p class="mt-3 leading-relaxed text-gray">{feature.body}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <!-- How to install -->
    <section class="mb-16 sm:mb-24">
        <h2 class="mb-6 font-serif text-xl italic sm:text-2xl">Add it to your device</h2>
        <p class="mb-10 max-w-2xl leading-relaxed text-gray sm:mb-12">
            StoryReader installs straight from your browser — no app store, no download. Open{' '}
            <a href={appUrl} class="underline decoration-dashed underline-offset-2 hover:decoration-solid">app.gunnerthelab.com</a>
            {' '}on the device you want it on, then follow the steps for your gadget.
        </p>
        <div class="grid gap-8 sm:grid-cols-2">
            {
                installGuides.map((guide) => (
                    <div class="border-main border-t border-dashed pt-6">
                        <h3 class="font-serif text-xl leading-tight font-medium">{guide.device}</h3>
                        <p class="mt-1 font-serif text-sm italic text-accent">{guide.browser}</p>
                        <ol class="mt-4 list-decimal space-y-2 pl-5 leading-relaxed text-gray">
                            {guide.steps.map((step) => (
                                <li set:html={step} />
                            ))}
                        </ol>
                        {guide.note && <p class="mt-3 text-sm italic text-gray">{guide.note}</p>}
                    </div>
                ))
            }
        </div>
        <p class="mt-10 text-gray">
            Prefer not to install anything? No problem — it works just as well right in the browser.
        </p>
    </section>

    <!-- Closing CTA -->
    <section class="mb-16 sm:mb-24">
        <div class="border-main border-t border-dashed pt-10 text-center sm:pt-14">
            <p class="mx-auto mb-8 max-w-xl font-serif text-2xl italic leading-snug sm:text-3xl">
                Mostly fictional. Always fun. Now read-aloud.
            </p>
            <Button href={appUrl}>Start Reading &amp; Listening</Button>
            <p class="mt-6 text-sm text-gray">
                Want a preview first? <a href="/stories" class="underline decoration-dashed underline-offset-2 hover:decoration-solid">Browse the stories</a> here on the website.
            </p>
        </div>
    </section>
</BaseLayout>
