# locally. See gunner-content/README.md.
/src/content/stories/*.md
/src/content/stories/*.mdx
!/src/content/stories/.gitkeep
/public/images/covers/*
!/public/images/covers/.gitkeep
/public/images/stories/*
!/public/images/stories/.gitkeep
